# Server Configuration
PORT=3000
NODE_ENV=production

# Security Keys (required in production; generate independent random values of 32+ characters)
JWT_SECRET=
ENCRYPTION_KEY=

# Storage Preferences
DEFAULT_STORAGE_MODE=dual
PRIMARY_PROVIDER=telegram
UPLOAD_STRATEGY=primary_first
# Balanced for a 6 vCPU / 16 GB VPS; preserves headroom for WebDAV and backups.
MAX_ACTIVE_UPLOAD_JOBS=3
MAX_UPLOAD_JOBS_PER_USER=2
MAX_QUEUED_UPLOAD_JOBS=24

# Credentials (Can be configured via Setup Wizard)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
SESSION_STRING=
# CyberPanel/Nginx: use 1 for one trusted reverse-proxy hop. Do not use true if the app port is publicly reachable.
TRUST_PROXY=1

# Optional security alerts (configure SMTP credentials only on the server)
TELEGRAM_ALERT_CHAT_ID=
DISCORD_ALERT_CHANNEL_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
